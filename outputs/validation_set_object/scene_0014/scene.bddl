(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.2133 0.0910 -0.1893 0.1150)
            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (0.1307 -0.0422 0.1547 -0.0182)
            )
          )
      )
      (bbq_sauce_2_region
          (:target floor)
          (:ranges (
              (-0.2134 -0.1492 -0.1894 -0.1252)
            )
          )
      )
      (bbq_sauce_3_region
          (:target floor)
          (:ranges (
              (0.0778 -0.1937 0.1018 -0.1697)
            )
          )
      )
      (bbq_sauce_4_region
          (:target floor)
          (:ranges (
              (-0.0440 -0.0564 -0.0200 -0.0324)
            )
          )
      )
      (bbq_sauce_5_region
          (:target floor)
          (:ranges (
              (-0.0969 -0.2613 -0.0729 -0.2373)
            )
          )
      )
      (alphabet_soup_1_region
          (:target floor)
          (:ranges (
              (-0.1540 -0.0490 -0.1300 -0.0250)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    bbq_sauce_1 bbq_sauce_2 bbq_sauce_3 bbq_sauce_4 bbq_sauce_5 - bbq_sauce
    basket_1 - basket
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
    (On bbq_sauce_2 floor_bbq_sauce_2_region)
    (On bbq_sauce_3 floor_bbq_sauce_3_region)
    (On bbq_sauce_4 floor_bbq_sauce_4_region)
    (On bbq_sauce_5 floor_bbq_sauce_5_region)
    (On alphabet_soup_1 floor_alphabet_soup_1_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)

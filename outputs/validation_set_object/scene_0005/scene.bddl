(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the bbq sauce and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0547 0.2364 -0.0307 0.2604)
            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (0.0780 -0.1682 0.1020 -0.1442)
            )
          )
      )
      (bbq_sauce_2_region
          (:target floor)
          (:ranges (
              (-0.1762 -0.0705 -0.1522 -0.0465)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.1771 -0.1858 -0.1531 -0.1618)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    bbq_sauce_1 bbq_sauce_2 - bbq_sauce
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
    (On bbq_sauce_2 floor_bbq_sauce_2_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)

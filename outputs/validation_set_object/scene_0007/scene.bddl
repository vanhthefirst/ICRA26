(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the chocolate pudding and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0747 0.2909 0.0987 0.3149)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.0498 -0.0467 -0.0258 -0.0227)
            )
          )
      )
      (chocolate_pudding_2_region
          (:target floor)
          (:ranges (
              (0.0222 -0.2419 0.0462 -0.2179)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.1194 -0.2105 -0.0954 -0.1865)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    chocolate_pudding_1 chocolate_pudding_2 - chocolate_pudding
    basket_1 - basket
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    chocolate_pudding_2
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
    (On chocolate_pudding_2 floor_chocolate_pudding_2_region)
    (On orange_juice_1 floor_orange_juice_1_region)
  )

  (:goal
    (And (In chocolate_pudding_2 basket_1_contain_region))
  )

)

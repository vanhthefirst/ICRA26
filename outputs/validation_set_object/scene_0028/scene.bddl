(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1479 0.1137 -0.1239 0.1377)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.1505 0.3072 0.1745 0.3312)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.0383 -0.2336 -0.0143 -0.2096)
            )
          )
      )
      (cream_cheese_2_region
          (:target floor)
          (:ranges (
              (0.1365 -0.1309 0.1605 -0.1069)
            )
          )
      )
      (cream_cheese_3_region
          (:target floor)
          (:ranges (
              (0.0139 -0.0732 0.0379 -0.0492)
            )
          )
      )
      (butter_1_region
          (:target floor)
          (:ranges (
              (-0.1323 -0.0764 -0.1083 -0.0524)
            )
          )
      )
      (alphabet_soup_1_region
          (:target floor)
          (:ranges (
              (0.0974 -0.2507 0.1214 -0.2267)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cream_cheese_1 cream_cheese_2 cream_cheese_3 - cream_cheese
    basket_1 basket_2 - basket
    butter_1 - butter
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    cream_cheese_1
    basket_2
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On cream_cheese_2 floor_cream_cheese_2_region)
    (On cream_cheese_3 floor_cream_cheese_3_region)
    (On butter_1 floor_butter_1_region)
    (On alphabet_soup_1 floor_alphabet_soup_1_region)
  )

  (:goal
    (And (In cream_cheese_1 basket_2_contain_region))
  )

)

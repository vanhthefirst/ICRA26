(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the alphabet soup and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0134 0.0650 0.0374 0.0890)
            )
          )
      )
      (alphabet_soup_1_region
          (:target floor)
          (:ranges (
              (-0.1627 -0.0901 -0.1387 -0.0661)
            )
          )
      )
      (alphabet_soup_2_region
          (:target floor)
          (:ranges (
              (0.0188 -0.0859 0.0428 -0.0619)
            )
          )
      )
      (alphabet_soup_3_region
          (:target floor)
          (:ranges (
              (0.0986 -0.2250 0.1226 -0.2010)
            )
          )
      )
      (alphabet_soup_4_region
          (:target floor)
          (:ranges (
              (-0.0964 -0.2541 -0.0724 -0.2301)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.2176 -0.2348 -0.1936 -0.2108)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 alphabet_soup_2 alphabet_soup_3 alphabet_soup_4 - alphabet_soup
    basket_1 - basket
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    alphabet_soup_3
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On alphabet_soup_1 floor_alphabet_soup_1_region)
    (On alphabet_soup_2 floor_alphabet_soup_2_region)
    (On alphabet_soup_3 floor_alphabet_soup_3_region)
    (On alphabet_soup_4 floor_alphabet_soup_4_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
  )

  (:goal
    (And (In alphabet_soup_3 basket_1_contain_region))
  )

)

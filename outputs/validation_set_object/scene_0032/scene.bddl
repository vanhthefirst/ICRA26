(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0110 0.3044 0.0130 0.3284)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.1711 0.1357 -0.1471 0.1597)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (0.1081 0.1230 0.1321 0.1470)
            )
          )
      )
      (tomato_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.1711 -0.1518 -0.1471 -0.1278)
            )
          )
      )
      (tomato_sauce_2_region
          (:target floor)
          (:ranges (
              (0.1019 -0.1086 0.1259 -0.0846)
            )
          )
      )
      (tomato_sauce_3_region
          (:target floor)
          (:ranges (
              (-0.0343 -0.2309 -0.0103 -0.2069)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.0550 -0.0722 -0.0310 -0.0482)
            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.1920 -0.2600 -0.1680 -0.2360)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    tomato_sauce_1 tomato_sauce_2 tomato_sauce_3 - tomato_sauce
    basket_1 basket_2 basket_3 - basket
    cream_cheese_1 - cream_cheese
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    tomato_sauce_3
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On tomato_sauce_1 floor_tomato_sauce_1_region)
    (On tomato_sauce_2 floor_tomato_sauce_2_region)
    (On tomato_sauce_3 floor_tomato_sauce_3_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
  )

  (:goal
    (And (In tomato_sauce_3 basket_1_contain_region))
  )

)

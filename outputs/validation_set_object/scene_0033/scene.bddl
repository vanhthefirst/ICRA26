  (:fixtures
    floor - floor
  )

  (:objects
    orange_juice_1 orange_juice_2 orange_juice_3 - orange_juice
    basket_1 basket_2 basket_3 - basket
    milk_1 - milk
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    orange_juice_3
    basket_2
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On orange_juice_1 floor_orange_juice_1_region)
    (On orange_juice_2 floor_orange_juice_2_region)
    (On orange_juice_3 floor_orange_juice_3_region)
    (On milk_1 floor_milk_1_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
  )

  (:goal
    (And (In orange_juice_3 basket_2_contain_region))
  )

)

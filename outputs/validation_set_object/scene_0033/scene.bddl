(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the orange juice and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1915 0.2426 -0.1675 0.2666)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.1704 0.0862 0.1944 0.1102)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (0.0986 0.3007 0.1226 0.3247)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.1754 -0.0612 -0.1514 -0.0372)
            )
          )
      )
      (orange_juice_2_region
          (:target floor)
          (:ranges (
              (0.0447 -0.2533 0.0687 -0.2293)
            )
          )
      )
      (orange_juice_3_region
          (:target floor)
          (:ranges (
              (-0.1699 -0.2640 -0.1459 -0.2400)
            )
          )
      )
      (milk_1_region

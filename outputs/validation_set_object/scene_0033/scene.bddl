            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.0587 -0.2314 -0.0347 -0.2074)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )

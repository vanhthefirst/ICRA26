(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the chocolate pudding and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.1729 0.2464 0.1969 0.2704)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.0260 0.0740 0.0500 0.0980)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.2089 -0.1964 -0.1849 -0.1724)
            )
          )
      )
      (salad_dressing_1_region
          (:target floor)
          (:ranges (
              (0.0904 -0.1143 0.1144 -0.0903)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    basket_1 basket_2 - basket
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_2
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
    (On salad_dressing_1 floor_salad_dressing_1_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_2_contain_region))
  )

)

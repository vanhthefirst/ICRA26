(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1025 0.0842 -0.0785 0.1082)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.1226 0.2142 0.1466 0.2382)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (-0.1335 0.2991 -0.1095 0.3231)
            )
          )
      )
      (tomato_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.1191 -0.2381 -0.0951 -0.2141)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.0548 -0.1126 -0.0308 -0.0886)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    tomato_sauce_1 - tomato_sauce
    basket_1 basket_2 basket_3 - basket
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    tomato_sauce_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On tomato_sauce_1 floor_tomato_sauce_1_region)
    (On orange_juice_1 floor_orange_juice_1_region)
  )

  (:goal
    (And (In tomato_sauce_1 basket_1_contain_region))
  )

)

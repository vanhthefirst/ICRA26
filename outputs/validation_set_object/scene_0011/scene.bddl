(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the butter and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1680 0.2783 -0.1440 0.3023)
            )
          )
      )
      (butter_1_region
          (:target floor)
          (:ranges (
              (-0.0013 -0.1313 0.0227 -0.1073)
            )
          )
      )
      (butter_2_region
          (:target floor)
          (:ranges (
              (-0.1054 -0.2181 -0.0814 -0.1941)
            )
          )
      )
      (butter_3_region
          (:target floor)
          (:ranges (
              (0.1523 -0.1945 0.1763 -0.1705)
            )
          )
      )
      (butter_4_region
          (:target floor)
          (:ranges (
              (-0.1744 -0.0511 -0.1504 -0.0271)
            )
          )
      )
      (tomato_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.2192 -0.2578 -0.1952 -0.2338)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    butter_1 butter_2 butter_3 butter_4 - butter
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On butter_1 floor_butter_1_region)
    (On butter_2 floor_butter_2_region)
    (On butter_3 floor_butter_3_region)
    (On butter_4 floor_butter_4_region)
    (On tomato_sauce_1 floor_tomato_sauce_1_region)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)

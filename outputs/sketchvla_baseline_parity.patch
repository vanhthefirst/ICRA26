+def register_sketch_export(export_dir: str) -> Dict[str, Dict[str, int]]:
+    """Install the sketch_prompted_vla suites using that export's own module.
+
+    `<export_dir>/register_sketch_suites.py` reads `task_map.json` next to it, so
+    the BDDL file, the pinned init-state file and the per-task reset seed all
+    come from the exporter. The fallback `register_custom_benchmark` below
+    guesses the init-state filename from the BDDL stem, which is one convention
+    change away from silently pairing a scene with the wrong pinned states.
+
+    Returns ({problem_folder: {task_name: reset_seed}},
+             {problem_folder: {task_name: ambiguous_caption}}).
+    """
+    export_path = pathlib.Path(export_dir).expanduser().resolve()
+    module_path = export_path / "register_sketch_suites.py"
+    if not module_path.exists():
+        raise FileNotFoundError(
+            f"{module_path} not found. --sketch_export_dir must point at the "
+            "scene export directory (the one holding task_map.json, bddl_files/ "
+            "and init_files/)."
+        )
+    if str(export_path) not in sys.path:
+        sys.path.insert(0, str(export_path))
+
+    import register_sketch_suites  # noqa: PLC0415
+
+    seeds = getattr(register_sketch_suites, "TASK_SEEDS", {})
+
+    task_map = getattr(register_sketch_suites, "SKETCH_TASK_MAP", None)
+    if task_map is None:
+        with open(export_path / "task_map.json") as fh:
+            task_map = json.load(fh)
+    ambiguous = {
+        pf: {t["name"]: t["language_ambiguous"]
+             for t in tasks if t.get("language_ambiguous")}
+        for pf, tasks in task_map.items()
+    }
+
+    logging.info(
+        "Registered sketch suites from %s: %s",
+        export_path, ", ".join(sorted(seeds)) or "(none reported)",
+    )
+    return seeds, ambiguous
+

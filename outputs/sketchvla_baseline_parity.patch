+class ZeroActionDatasetError(RuntimeError):
+    """Raised when the source RLDS carries no action signal to imitate."""
+
+
+def _assert_trainable(
+    *,
+    n_episodes: int,
+    n_steps: int,
+    n_zero_action_episodes: int,
+    n_no_demo_episodes: int,
+    allow_zero_actions: bool,
+) -> None:
+    """Refuse to emit a training set whose actions are all zero.
+
+    A validation export -- scenes built from BDDLs, pinned at their annotated
+    start frame -- has one step per episode and `action = zeros(7)`, because
+    there is no demonstration behind it. Fine-tuning on that regresses the
+    policy onto a constant zero action: the arm never moves and every rollout
+    scores 0%, with no error raised anywhere along the way. That failure is
+    invisible at train time and looks like a modelling problem at eval time,
+    so it is caught here instead.
+    """
+    print(
+        f"Converted {n_episodes} episode(s), {n_steps} step(s); "
+        f"{n_zero_action_episodes} episode(s) with all-zero actions, "
+        f"{n_no_demo_episodes} flagged has_demonstration=False."
+    )
+    if n_episodes == 0:
+        raise ZeroActionDatasetError("The source dataset yielded no episodes.")
+
+    if n_zero_action_episodes < n_episodes and n_no_demo_episodes == 0:
+        return
+
+    detail = []
+    if n_zero_action_episodes == n_episodes:
+        detail.append(f"all {n_episodes} episode(s) have action == 0 at every step")
+    if n_no_demo_episodes:
+        detail.append(f"{n_no_demo_episodes} episode(s) set has_demonstration=False")
+    message = (
+        "This RLDS is a validation set, not a training set: "
+        + "; ".join(detail)
+        + ".\nFine-tuning on it yields a policy that emits zero actions and scores 0% "
+        "on every rollout.\nUse a demonstration-bearing source (e.g. the LIBERO demos "
+        "in openvla/modified_libero_rlds, with sketches attached) as the training "
+        "corpus, and keep the validation export for scoring only.\n"
+        "Pass allow_zero_actions=True only if you genuinely intend a zero-action dataset."
+    )
+    if allow_zero_actions:
+        print("WARNING: " + message)
+        return
+    raise ZeroActionDatasetError(message)
+
+

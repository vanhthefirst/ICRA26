(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0934 0.0939 0.1174 0.1179)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.0343 0.2601 -0.0103 0.2841)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.0529 0.0467 -0.0289 0.0707)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.1768 0.1623 -0.1528 0.1863)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.1987 -0.0177 -0.1747 0.0063)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0071 -0.0514 0.0311 -0.0274)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)

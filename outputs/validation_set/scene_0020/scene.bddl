(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0461 0.0528 -0.0221 0.0768)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.0216 0.2482 0.0456 0.2722)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.0841 0.0898 0.1081 0.1138)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.0983 0.2281 -0.0743 0.2521)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.1933 -0.0527 -0.1693 -0.0287)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.2001 0.2007 -0.1761 0.2247)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_3
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_3))
  )

)

(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1166 0.2303 -0.0926 0.2543)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.0007 0.2204 0.0233 0.2444)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.1482 -0.0411 0.1722 -0.0171)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.1738 0.0037 -0.1498 0.0277)
            )
          )
      )
      (plate_4_region
          (:target main_table)
          (:ranges (
              (-0.0123 -0.0561 0.0117 -0.0321)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.0411 0.0334 0.0651 0.0574)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.1026 0.2597 0.1266 0.2837)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 plate_4 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_2
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On plate_4 main_table_plate_4_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_2))
  )

)

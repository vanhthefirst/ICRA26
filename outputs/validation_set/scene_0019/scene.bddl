(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0046 0.0504 0.0194 0.0744)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.0893 0.0910 0.1133 0.1150)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.1077 0.0716 -0.0837 0.0956)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.1109 0.2705 0.1349 0.2945)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0946 -0.0058 0.1186 0.0182)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_2
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_2))
  )

)

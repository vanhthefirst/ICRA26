(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0109 0.1103 0.0131 0.1343)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (-0.1217 0.2334 -0.0977 0.2574)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (-0.2098 0.0498 -0.1858 0.0738)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.0819 0.1972 0.1059 0.2212)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.0819 0.0053 -0.0579 0.0293)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0396 0.0281 0.0636 0.0521)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 - akita_black_bowl
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_2
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On akita_black_bowl_2 main_table_akita_black_bowl_2_region)
    (On akita_black_bowl_3 main_table_akita_black_bowl_3_region)
    (On plate_1 main_table_plate_1_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_2 plate_1))
  )

)

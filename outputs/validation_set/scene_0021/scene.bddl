(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bowl and put it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0320 0.0311 0.0560 0.0551)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.0988 -0.0580 -0.0748 -0.0340)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.0933 0.2697 -0.0693 0.2937)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (0.1434 0.2162 0.1674 0.2402)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.2073 0.1067 -0.1833 0.1307)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.0995 0.1573 -0.0755 0.1813)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_2
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_2))
  )

)

(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0073 -0.0306 0.0313 -0.0066)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.0887 0.0643 -0.0647 0.0883)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.0942 0.1643 -0.0702 0.1883)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0834 0.2769 0.1074 0.3009)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)

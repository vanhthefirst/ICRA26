(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0865 -0.0271 0.1105 -0.0031)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.0404 0.1578 0.0644 0.1818)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.1824 0.2611 0.2064 0.2851)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.0169 0.0119 0.0071 0.0359)
            )
          )
      )
      (plate_4_region
          (:target main_table)
          (:ranges (
              (-0.0616 0.2909 -0.0376 0.3149)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.1883 -0.0063 -0.1643 0.0177)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.0885 0.1223 -0.0645 0.1463)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 plate_4 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_3
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On plate_4 main_table_plate_4_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_3))
  )

)

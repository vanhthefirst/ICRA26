(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1989 0.3072 -0.1749 0.3312)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.1344 0.0928 0.1584 0.1168)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.1077 0.0714 -0.0837 0.0954)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.1634 0.1903 0.1874 0.2143)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.2284 0.0394 -0.2044 0.0634)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)

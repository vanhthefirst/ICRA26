(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the chocolate pudding and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0882 0.0954 0.1122 0.1194)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.1115 0.2920 -0.0875 0.3160)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.0453 -0.0797 -0.0213 -0.0557)
            )
          )
      )
      (chocolate_pudding_2_region
          (:target floor)
          (:ranges (
              (-0.2102 -0.0437 -0.1862 -0.0197)
            )
          )
      )
      (chocolate_pudding_3_region
          (:target floor)
          (:ranges (
              (0.0589 -0.2496 0.0829 -0.2256)
            )
          )
      )
      (salad_dressing_1_region
          (:target floor)
          (:ranges (
              (0.1098 -0.1368 0.1338 -0.1128)
            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (-0.1885 -0.1971 -0.1645 -0.1731)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    chocolate_pudding_1 chocolate_pudding_2 chocolate_pudding_3 - chocolate_pudding
    basket_1 basket_2 - basket
    salad_dressing_1 - salad_dressing
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_2
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
    (On chocolate_pudding_2 floor_chocolate_pudding_2_region)
    (On chocolate_pudding_3 floor_chocolate_pudding_3_region)
    (On salad_dressing_1 floor_salad_dressing_1_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_2_contain_region))
  )

)

(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1653 0.2426 -0.1413 0.2666)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.0929 0.2545 0.1169 0.2785)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.1407 -0.1469 -0.1167 -0.1229)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (-0.0233 -0.2400 0.0007 -0.2160)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cream_cheese_1 - cream_cheese
    basket_1 basket_2 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    cream_cheese_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On milk_1 floor_milk_1_region)
  )

  (:goal
    (And (In cream_cheese_1 basket_1_contain_region))
  )

)

(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0727 0.0572 -0.0487 0.0812)
            )
          )
      )
      (tomato_sauce_1_region
          (:target floor)
          (:ranges (
              (0.1522 -0.0796 0.1762 -0.0556)
            )
          )
      )
      (tomato_sauce_2_region
          (:target floor)
          (:ranges (
              (-0.0130 -0.1782 0.0110 -0.1542)
            )
          )
      )
      (tomato_sauce_3_region
          (:target floor)
          (:ranges (
              (-0.2014 -0.2382 -0.1774 -0.2142)
            )
          )
      )
      (tomato_sauce_4_region
          (:target floor)
          (:ranges (
              (-0.2178 -0.0712 -0.1938 -0.0472)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (0.1196 -0.1800 0.1436 -0.1560)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    tomato_sauce_1 tomato_sauce_2 tomato_sauce_3 tomato_sauce_4 - tomato_sauce
    basket_1 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    tomato_sauce_2
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On tomato_sauce_1 floor_tomato_sauce_1_region)
    (On tomato_sauce_2 floor_tomato_sauce_2_region)
    (On tomato_sauce_3 floor_tomato_sauce_3_region)
    (On tomato_sauce_4 floor_tomato_sauce_4_region)
    (On milk_1 floor_milk_1_region)
  )

  (:goal
    (And (In tomato_sauce_2 basket_1_contain_region))
  )

)

(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0387 0.2018 -0.0147 0.2258)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.1932 0.0652 0.2172 0.0892)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (0.1588 0.2912 0.1828 0.3152)
            )
          )
      )
      (ketchup_1_region
          (:target floor)
          (:ranges (
              (-0.0431 -0.1007 -0.0191 -0.0767)
            )
          )
      )
      (ketchup_2_region
          (:target floor)
          (:ranges (
              (0.1046 -0.2515 0.1286 -0.2275)
            )
          )
      )
      (ketchup_3_region
          (:target floor)
          (:ranges (
              (-0.1768 -0.2459 -0.1528 -0.2219)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (0.1124 -0.0636 0.1364 -0.0396)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.0718 -0.2036 -0.0478 -0.1796)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    ketchup_1 ketchup_2 ketchup_3 - ketchup
    basket_1 basket_2 basket_3 - basket
    cream_cheese_1 - cream_cheese
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    ketchup_2
    basket_3
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On ketchup_1 floor_ketchup_1_region)
    (On ketchup_2 floor_ketchup_2_region)
    (On ketchup_3 floor_ketchup_3_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On orange_juice_1 floor_orange_juice_1_region)
  )

  (:goal
    (And (In ketchup_2 basket_3_contain_region))
  )

)

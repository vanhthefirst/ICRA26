(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the milk and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0323 0.2426 -0.0083 0.2666)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.2180 0.0701 -0.1940 0.0941)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (-0.0890 -0.1411 -0.0650 -0.1171)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (0.1288 -0.1171 0.1528 -0.0931)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    milk_1 - milk
    basket_1 basket_2 - basket
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On milk_1 floor_milk_1_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)

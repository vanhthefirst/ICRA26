(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.1876 0.1070 0.2116 0.1310)
            )
          )
      )
      (ketchup_1_region
          (:target floor)
          (:ranges (
              (0.0801 -0.2650 0.1041 -0.2410)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.1169 -0.1267 -0.0929 -0.1027)
            )
          )
      )
      (butter_1_region
          (:target floor)
          (:ranges (
              (-0.2150 -0.0490 -0.1910 -0.0250)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    cream_cheese_1 - cream_cheese
    butter_1 - butter
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On ketchup_1 floor_ketchup_1_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On butter_1 floor_butter_1_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)

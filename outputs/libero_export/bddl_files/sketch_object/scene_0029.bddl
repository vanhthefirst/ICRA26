(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the butter and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.1477 0.1095 0.1717 0.1335)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.1953 0.2375 -0.1713 0.2615)
            )
          )
      )
      (butter_1_region
          (:target floor)
          (:ranges (
              (-0.0554 -0.2136 -0.0314 -0.1896)
            )
          )
      )
      (butter_2_region
          (:target floor)
          (:ranges (
              (-0.1608 -0.1003 -0.1368 -0.0763)
            )
          )
      )
      (butter_3_region
          (:target floor)
          (:ranges (
              (0.1148 -0.1332 0.1388 -0.1092)
            )
          )
      )
      (butter_4_region
          (:target floor)
          (:ranges (
              (-0.0348 -0.0522 -0.0108 -0.0282)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (0.0957 -0.2622 0.1197 -0.2382)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (-0.2119 -0.2291 -0.1879 -0.2051)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    butter_1 butter_2 butter_3 butter_4 - butter
    basket_1 basket_2 - basket
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    butter_2
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On butter_1 floor_butter_1_region)
    (On butter_2 floor_butter_2_region)
    (On butter_3 floor_butter_3_region)
    (On butter_4 floor_butter_4_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
  )

  (:goal
    (And (In butter_2 basket_1_contain_region))
  )

)

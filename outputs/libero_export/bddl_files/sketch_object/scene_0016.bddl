(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.1114 0.0583 -0.0874 0.0823)
            )
          )
      )
      (cream_cheese_1_region
          (:target floor)
          (:ranges (
              (0.1202 -0.1372 0.1442 -0.1132)
            )
          )
      )
      (cream_cheese_2_region
          (:target floor)
          (:ranges (
              (-0.1421 -0.1296 -0.1181 -0.1056)
            )
          )
      )
      (cream_cheese_3_region
          (:target floor)
          (:ranges (
              (-0.1712 -0.2633 -0.1472 -0.2393)
            )
          )
      )
      (cream_cheese_4_region
          (:target floor)
          (:ranges (
              (0.0133 -0.2436 0.0373 -0.2196)
            )
          )
      )
      (cream_cheese_5_region
          (:target floor)
          (:ranges (
              (0.0113 -0.0334 0.0353 -0.0094)
            )
          )
      )
      (tomato_sauce_1_region
          (:target floor)
          (:ranges (
              (0.1510 -0.2533 0.1750 -0.2293)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cream_cheese_1 cream_cheese_2 cream_cheese_3 cream_cheese_4 cream_cheese_5 - cream_cheese
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    cream_cheese_2
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On cream_cheese_1 floor_cream_cheese_1_region)
    (On cream_cheese_2 floor_cream_cheese_2_region)
    (On cream_cheese_3 floor_cream_cheese_3_region)
    (On cream_cheese_4 floor_cream_cheese_4_region)
    (On cream_cheese_5 floor_cream_cheese_5_region)
    (On tomato_sauce_1 floor_tomato_sauce_1_region)
  )

  (:goal
    (And (In cream_cheese_2 basket_1_contain_region))
  )

)

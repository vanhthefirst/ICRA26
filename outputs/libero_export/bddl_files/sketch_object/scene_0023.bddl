(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the orange juice and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.2101 0.2469 -0.1861 0.2709)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (0.0211 0.1121 0.0451 0.1361)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (0.1606 0.2844 0.1846 0.3084)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (0.0637 -0.0912 0.0877 -0.0672)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.0234 -0.1952 0.0006 -0.1712)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    orange_juice_1 - orange_juice
    basket_1 basket_2 basket_3 - basket
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    orange_juice_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On orange_juice_1 floor_orange_juice_1_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )

)

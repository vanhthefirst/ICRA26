(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the orange juice and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.1004 0.2398 0.1244 0.2638)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.0928 -0.1996 -0.0688 -0.1756)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.0335 -0.0433 -0.0095 -0.0193)
            )
          )
      )
      (ketchup_1_region
          (:target floor)
          (:ranges (
              (0.1460 -0.0736 0.1700 -0.0496)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    orange_juice_1 - orange_juice
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    orange_juice_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On orange_juice_1 floor_orange_juice_1_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
    (On ketchup_1 floor_ketchup_1_region)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )

)

(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.1292 0.1631 0.1532 0.1871)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.1458 0.0469 -0.1218 0.0709)
            )
          )
      )
      (basket_3_region
          (:target floor)
          (:ranges (
              (-0.1506 0.2699 -0.1266 0.2939)
            )
          )
      )
      (bbq_sauce_1_region
          (:target floor)
          (:ranges (
              (0.0089 -0.1693 0.0329 -0.1453)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (-0.1856 -0.1940 -0.1616 -0.1700)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
      (contain_region
          (:target basket_3)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    basket_1 basket_2 basket_3 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On basket_3 floor_basket_3_region)
    (On bbq_sauce_1 floor_bbq_sauce_1_region)
    (On milk_1 floor_milk_1_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)

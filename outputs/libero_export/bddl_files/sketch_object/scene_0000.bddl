(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.0387 0.1199 -0.0147 0.1439)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (-0.0670 -0.2214 -0.0430 -0.1974)
            )
          )
      )
      (ketchup_1_region
          (:target floor)
          (:ranges (
              (0.0066 -0.0587 0.0306 -0.0347)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (0.0691 -0.1651 0.0931 -0.1411)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    milk_1 - milk
    basket_1 - basket
    ketchup_1 - ketchup
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On milk_1 floor_milk_1_region)
    (On ketchup_1 floor_ketchup_1_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)

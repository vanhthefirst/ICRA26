(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the alphabet soup and place it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0477 0.1024 0.0717 0.1264)
            )
          )
      )
      (alphabet_soup_1_region
          (:target floor)
          (:ranges (
              (-0.1138 -0.2643 -0.0898 -0.2403)
            )
          )
      )
      (orange_juice_1_region
          (:target floor)
          (:ranges (
              (-0.1083 -0.0443 -0.0843 -0.0203)
            )
          )
      )
      (salad_dressing_1_region
          (:target floor)
          (:ranges (
              (0.1284 -0.0802 0.1524 -0.0562)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    orange_juice_1 - orange_juice
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On alphabet_soup_1 floor_alphabet_soup_1_region)
    (On orange_juice_1 floor_orange_juice_1_region)
    (On salad_dressing_1 floor_salad_dressing_1_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

)

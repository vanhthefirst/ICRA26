(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the alphabet soup and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0994 0.2175 0.1234 0.2415)
            )
          )
      )
      (basket_2_region
          (:target floor)
          (:ranges (
              (-0.1914 0.1524 -0.1674 0.1764)
            )
          )
      )
      (alphabet_soup_1_region
          (:target floor)
          (:ranges (
              (-0.2219 -0.0810 -0.1979 -0.0570)
            )
          )
      )
      (milk_1_region
          (:target floor)
          (:ranges (
              (0.0082 -0.0473 0.0322 -0.0233)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region
          (:target basket_2)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 basket_2 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_2
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On basket_2 floor_basket_2_region)
    (On alphabet_soup_1 floor_alphabet_soup_1_region)
    (On milk_1 floor_milk_1_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_2_contain_region))
  )

)

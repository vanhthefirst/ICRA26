(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language grab the butter and put it in the basket)
    (:regions
      (basket_1_region
          (:target floor)
          (:ranges (
              (0.0566 0.2664 0.0806 0.2904)
            )
          )
      )
      (butter_1_region
          (:target floor)
          (:ranges (
              (0.0855 -0.2257 0.1095 -0.2017)
            )
          )
      )
      (butter_2_region
          (:target floor)
          (:ranges (
              (-0.1668 -0.0801 -0.1428 -0.0561)
            )
          )
      )
      (butter_3_region
          (:target floor)
          (:ranges (
              (0.1235 -0.0694 0.1475 -0.0454)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target floor)
          (:ranges (
              (-0.1521 -0.2498 -0.1281 -0.2258)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    butter_1 butter_2 butter_3 - butter
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    butter_2
    basket_1
  )

  (:init
    (On basket_1 floor_basket_1_region)
    (On butter_1 floor_butter_1_region)
    (On butter_2 floor_butter_2_region)
    (On butter_3 floor_butter_3_region)
    (On chocolate_pudding_1 floor_chocolate_pudding_1_region)
  )

  (:goal
    (And (In butter_2 basket_1_contain_region))
  )

)

(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1125 0.0043 -0.0885 0.0283)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (0.1126 0.1807 0.1366 0.2047)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (-0.1669 0.2081 -0.1429 0.2321)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.1731 0.0550 0.1971 0.0790)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.1505 0.2749 0.1745 0.2989)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.0951 0.1272 -0.0711 0.1512)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (

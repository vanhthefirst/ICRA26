            )
          )
      )
      (glazed_rim_porcelain_ramekin_2_region
          (:target main_table)
          (:ranges (
              (-0.1992 -0.0487 -0.1752 -0.0247)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.0578 0.2481 -0.0338 0.2721)
            )
          )
      )
      (cookies_2_region
          (:target main_table)
          (:ranges (
              (0.0710 0.0471 0.0950 0.0711)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 glazed_rim_porcelain_ramekin_2 - glazed_rim_porcelain_ramekin
    cookies_1 cookies_2 - cookies
  )

  (:obj_of_interest

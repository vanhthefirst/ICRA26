(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0411 0.2730 -0.0171 0.2970)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.1382 0.2141 -0.1142 0.2381)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.1435 0.0369 -0.1195 0.0609)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (0.1506 -0.0467 0.1746 -0.0227)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.1082 0.0957 0.1322 0.1197)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.2272 0.0929 -0.2032 0.1169)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_2
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_2))
  )

)

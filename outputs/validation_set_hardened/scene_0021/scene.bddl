(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1780 0.2676 -0.1540 0.2916)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.0175 0.1474 0.0415 0.1714)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.0976 0.0071 -0.0736 0.0311)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (0.1438 0.0536 0.1678 0.0776)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.0358 0.2834 -0.0118 0.3074)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0701 0.2292 0.0941 0.2532)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)

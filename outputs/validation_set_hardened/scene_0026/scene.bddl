(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1214 -0.0309 -0.0974 -0.0069)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (0.1517 0.1379 0.1757 0.1619)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (-0.0809 0.2864 -0.0569 0.3104)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.1382 0.1502 -0.1142 0.1742)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.0336 -0.0341 0.0576 -0.0101)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.1792 0.0577 -0.1552 0.0817)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_2_region
          (:target main_table)
          (:ranges (
              (-0.0483 0.0442 -0.0243 0.0682)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.2213 0.1862 -0.1973 0.2102)
            )
          )
      )
      (cookies_2_region
          (:target main_table)
          (:ranges (
              (0.1732 0.2314 0.1972 0.2554)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 - akita_black_bowl
    plate_1 plate_2 - plate
    glazed_rim_porcelain_ramekin_1 glazed_rim_porcelain_ramekin_2 - glazed_rim_porcelain_ramekin
    cookies_1 cookies_2 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_3
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On akita_black_bowl_2 main_table_akita_black_bowl_2_region)
    (On akita_black_bowl_3 main_table_akita_black_bowl_3_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On glazed_rim_porcelain_ramekin_2 main_table_glazed_rim_porcelain_ramekin_2_region)
    (On cookies_1 main_table_cookies_1_region)
    (On cookies_2 main_table_cookies_2_region)
  )

  (:goal
    (And (On akita_black_bowl_3 plate_1))
  )

)

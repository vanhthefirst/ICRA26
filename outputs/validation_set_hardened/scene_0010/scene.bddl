(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bowl and put it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0487 0.0527 -0.0247 0.0767)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (0.0262 0.2648 0.0502 0.2888)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (-0.2113 -0.0620 -0.1873 -0.0380)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.1853 0.2959 -0.1613 0.3199)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.1630 0.1190 0.1870 0.1430)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.1835 0.0466 -0.1595 0.0706)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 - akita_black_bowl
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_3
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On akita_black_bowl_2 main_table_akita_black_bowl_2_region)
    (On akita_black_bowl_3 main_table_akita_black_bowl_3_region)
    (On plate_1 main_table_plate_1_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_3 plate_1))
  )

)

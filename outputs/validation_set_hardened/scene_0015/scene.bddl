(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.1265 0.2453 -0.1025 0.2693)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (0.0015 0.2346 0.0255 0.2586)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (0.1661 -0.0493 0.1901 -0.0253)
            )
          )
      )
      (akita_black_bowl_4_region
          (:target main_table)
          (:ranges (
              (-0.1898 -0.0007 -0.1658 0.0233)
            )
          )
      )
      (akita_black_bowl_5_region
          (:target main_table)
          (:ranges (
              (-0.1846 0.1703 -0.1606 0.1943)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.2116 0.2767 -0.1876 0.3007)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.0113 -0.0656 0.0127 -0.0416)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0478 0.0316 0.0718 0.0556)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 akita_black_bowl_4 akita_black_bowl_5 - akita_black_bowl
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_4
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On akita_black_bowl_2 main_table_akita_black_bowl_2_region)
    (On akita_black_bowl_3 main_table_akita_black_bowl_3_region)
    (On akita_black_bowl_4 main_table_akita_black_bowl_4_region)
    (On akita_black_bowl_5 main_table_akita_black_bowl_5_region)
    (On plate_1 main_table_plate_1_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_4 plate_1))
  )

)

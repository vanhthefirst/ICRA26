(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bowl and put it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0034 -0.0218 0.0274 0.0022)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.1610 0.2140 -0.1370 0.2380)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.0396 0.2208 0.0636 0.2448)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (0.0917 0.0515 0.1157 0.0755)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.0811 0.0375 -0.0571 0.0615)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.0514 0.1906 -0.0274 0.2146)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_3
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_3))
  )

)

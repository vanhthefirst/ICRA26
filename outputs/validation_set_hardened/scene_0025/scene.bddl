(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language grab the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0123 0.0172 0.0117 0.0412)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.0979 -0.0173 -0.0739 0.0067)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (0.0388 0.1145 0.0628 0.1385)
            )
          )
      )
      (plate_3_region
          (:target main_table)
          (:ranges (
              (-0.1119 0.1597 -0.0879 0.1837)
            )
          )
      )
      (plate_4_region
          (:target main_table)
          (:ranges (
              (0.1681 0.0779 0.1921 0.1019)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (-0.1945 0.2325 -0.1705 0.2565)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.1292 -0.0132 0.1532 0.0108)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 plate_2 plate_3 plate_4 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
    (On plate_2 main_table_plate_2_region)
    (On plate_3 main_table_plate_3_region)
    (On plate_4 main_table_plate_4_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)

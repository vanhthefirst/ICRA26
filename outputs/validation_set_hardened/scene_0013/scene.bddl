(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl and place it on the plate)
    (:regions
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0398 0.1233 -0.0158 0.1473)
            )
          )
      )
      (akita_black_bowl_2_region
          (:target main_table)
          (:ranges (
              (-0.0531 -0.0197 -0.0291 0.0043)
            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (0.1462 0.2735 0.1702 0.2975)
            )
          )
      )
      (akita_black_bowl_4_region
          (:target main_table)
          (:ranges (
              (-0.1874 0.1901 -0.1634 0.2141)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.1581 0.1604 0.1821 0.1844)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target main_table)
          (:ranges (
              (0.0143 0.2349 0.0383 0.2589)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0704 0.0072 0.0944 0.0312)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 akita_black_bowl_4 - akita_black_bowl
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    cookies_1 - cookies
  )

  (:obj_of_interest
    akita_black_bowl_2
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On akita_black_bowl_2 main_table_akita_black_bowl_2_region)
    (On akita_black_bowl_3 main_table_akita_black_bowl_3_region)
    (On akita_black_bowl_4 main_table_akita_black_bowl_4_region)
    (On plate_1 main_table_plate_1_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_1_region)
    (On cookies_1 main_table_cookies_1_region)
  )

  (:goal
    (And (On akita_black_bowl_2 plate_1))
  )

)

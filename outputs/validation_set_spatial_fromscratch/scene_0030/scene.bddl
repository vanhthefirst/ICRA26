            )
          )
      )
      (akita_black_bowl_3_region
          (:target main_table)
          (:ranges (
              (-0.0761 0.1919 -0.0521 0.2159)
            )
          )
      )
      (akita_black_bowl_4_region
          (:target main_table)
          (:ranges (
              (0.1805 0.2205 0.2045 0.2445)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (0.1133 0.1139 0.1373 0.1379)
            )
          )
      )
      (plate_2_region
          (:target main_table)
          (:ranges (
              (-0.0389 -0.0437 -0.0149 -0.0197)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region

#!/usr/bin/env python3
"""Re-rate an anchored run on the swap-capable scene subset.

The published anchored baselines -- 40.3% explicit, 36.5% ambiguous -- are over
all 37 scenes. A V7 real/swap pair can only run on the 24 that admit an
unambiguous ring around the distractor (scripts/build_anchored_swap_sketches.py
decides which, and writes swap_scene_list.txt). Those 24 are NOT a random
sample: they are harder, because the scenes where a ring fits cleanly around
bowl_2 are the ones where bowl_2 is well inside the frame and well separated,
which correlates with a busier layout.

Measured: 40.3% -> 29.5% explicit, 36.5% -> 25.9% ambiguous. Reading a 24-scene
V7 number against the 37-scene baseline would credit it with eleven points it
did not earn. This script exists so nobody does that from memory.

    scripts/analysis/anchored_subset outputs/rollouts/pi05_anchored_*_518
"""
import csv
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
LIST = os.path.join(REPO, "outputs", "validation_set_spatial", "swap_scene_list.txt")

FIELDS = ("success_sustained", "success_final", "correct_instance_grasped", "grasped_any")


def rate(rows, field):
    rows = [r for r in rows if field in r and r[field] != ""]
    if not rows:
        return None, 0
    return sum(r[field] == "True" for r in rows) / len(rows), len(rows)


def main(run_dirs):
    if not os.path.exists(LIST):
        raise SystemExit("no %s -- run scripts/build_anchored_swap_sketches.py first" % LIST)
    keep = {tok.split("/", 1)[1] for tok in open(LIST).read().strip().split(",") if tok}
    print("swap-capable subset: %d scenes\n" % len(keep))

    for run in run_dirs:
        path = os.path.join(run, "results.csv")
        if not os.path.exists(path):
            print("%-30s no results.csv" % os.path.basename(run))
            continue
        rows = [r for r in csv.DictReader(open(path)) if r.get("skipped") != "True"]
        sub = [r for r in rows if r["dir"] in keep]
        missing = keep - {r["dir"] for r in rows}
        print("%s  (%d scenes, %d rows)" % (os.path.basename(run),
                                            len({r["dir"] for r in rows}), len(rows)))
        print("  %-26s%14s%14s%10s" % ("", "all scenes", "subset", "delta"))
        for field in FIELDS:
            a, na = rate(rows, field)
            b, nb = rate(sub, field)
            if a is None or b is None:
                continue
            print("  %-26s%10.4f(%3d)%10.4f(%3d)%+10.4f" % (field, a, na, b, nb, b - a))
        if missing:
            print("  MISSING from this run: %s" % ",".join(sorted(missing)))
        print()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    main(sys.argv[1:])
